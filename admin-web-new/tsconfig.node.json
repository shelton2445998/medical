{
  /**
   * TypeScript Node.js 环境配置
   * 用于配置构建工具和服务器端代码的编译选项
   */
  "compilerOptions": {
    "composite": true,                        // 启用复合项目模式
    "module": "ESNext",                       // 使用 ESNext 模块系统
    "moduleResolution": "Node",               // 使用 Node.js 模块解析策略
    "allowSyntheticDefaultImports": true     // 允许合成默认导入
  },
  /**
   * 包含的文件
   * 指定这个配置文件应该处理的文件
   */
  "include": ["vite.config.ts"]
}
