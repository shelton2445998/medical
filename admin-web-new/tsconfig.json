{
  /**
   * TypeScript 编译器配置
   * 定义 TypeScript 编译行为和项目设置
   */
  "compilerOptions": {
    // 编译目标版本，使用最新的 ES 规范
    "target": "ESNext",
    // 启用类字段的 defineProperty 语义
    "useDefineForClassFields": true,
    // 模块系统类型
    "module": "ESNext",
    // 模块解析策略
    "moduleResolution": "Node",
    // 启用严格类型检查
    "strict": true,
    // JSX 编译方式，保留 JSX 语法
    "jsx": "preserve",
    // 允许导入 JSON 文件
    "resolveJsonModule": true,
    // 每个文件作为单独的模块编译
    "isolatedModules": true,
    // 支持 ES 模块和 CommonJS 的互操作
    "esModuleInterop": true,
    // 编译时包含的库
    "lib": ["ESNext", "DOM"],
    // 跳过库文件的类型检查
    "skipLibCheck": true,
    // 不生成编译输出文件
    "noEmit": true,
    // 模块解析的基准目录
    "baseUrl": ".",
    // 包含的类型声明
    "types": ["vite-plugin-svg-icons/client"],
    // 路径映射配置
    "paths": {
      // @ 符号映射到 src 目录
      "@/*": ["src/*"],
    }
  },
  /**
   * 包含的文件和目录
   * 指定 TypeScript 编译器应该处理的文件
   */
  "include": [
    "src/**/*.ts",      // 所有 TypeScript 文件
    "src/**/*.d.ts",    // 类型声明文件
    "src/**/*.tsx",     // TypeScript + JSX 文件
    "src/**/*.vue",     // Vue 单文件组件
    "types/*.d.ts",     // 类型定义文件
    "vite.config.ts"    // Vite 配置文件
  ],
  /**
   * 项目引用
   * 用于多项目构建
   */
  "references": [{ "path": "./tsconfig.node.json" }]
}
